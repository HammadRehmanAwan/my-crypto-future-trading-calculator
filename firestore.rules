rules_version = '2';

// FutureX Firestore security rules.
// Deploy: Firebase console → Firestore → Rules → paste → Publish
//     or: firebase deploy --only firestore:rules
//
// The server (backend.py, scripts/*.py) uses the Admin SDK, which bypasses
// these rules. Browsers get only what is listed here — in particular they can
// NEVER write subscriptions, so a user cannot grant themselves a paid plan.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // users/{uid}/data/{doc}
    //   settings    – alert preferences       (owner read/write/delete)
    //   profile     – email, consent, signup  (owner read/write/delete; email must be
    //                 the signed-in Google email; `lifecycle` is server-only)
    //   telegram    – linked chat id          (owner read/delete; server write)
    //   alert_state – cooldowns/daily cap     (owner read/delete; server write)
    function smallDoc() { return request.resource.data.size() < 20; }
    function emailOk() {
      return !('email' in request.resource.data)
        || request.resource.data.email == null
        || request.resource.data.email == request.auth.token.email;
    }
    match /users/{uid}/data/{doc} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && smallDoc() && (
        doc == 'settings' ||
        (doc == 'profile' && emailOk() && !('lifecycle' in request.resource.data)));
      allow update: if isOwner(uid) && smallDoc() && (
        doc == 'settings' ||
        (doc == 'profile' && emailOk()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lifecycle'])));
      // Erasure: the owner may delete every one of their documents.
      allow delete: if isOwner(uid) && doc in ['settings', 'profile', 'telegram', 'alert_state'];
    }

    // Subscription state — written only by the Lemon Squeezy webhook.
    match /subscriptions/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // One-time Telegram link codes. The browser may create one for itself;
    // only the server reads/redeems them.
    match /telegram_links/{code} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && code.size() >= 16 && code.size() <= 64;
      allow read, update, delete: if false;
    }

    // Server-only bookkeeping.
    match /ls_subscriptions/{id} { allow read, write: if false; }
    match /telegram_chats/{id}   { allow read, write: if false; }
    match /system/{id}           { allow read, write: if false; }
  }
}
